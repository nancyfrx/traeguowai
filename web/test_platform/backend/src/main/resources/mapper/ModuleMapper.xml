<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.testplatform.backend.repository.ModuleMapper">
    <resultMap id="BaseResultMap" type="com.testplatform.backend.entity.Module">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="parent_id" property="parentId" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM module ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO module (name, parent_id, created_at, updated_at)
        VALUES (#{name}, #{parentId}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE module
        SET name = #{name}, parent_id = #{parentId}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM module WHERE id = #{id}
    </delete>
</mapper>
