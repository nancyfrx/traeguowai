<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.testplatform.backend.repository.ModuleRepository">
    <resultMap id="BaseResultMap" type="com.testplatform.backend.entity.Module">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="project_id" property="projectId" />
        <result column="parent_id" property="parentId" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM modules WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM modules ORDER BY id ASC
    </select>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO modules (name, project_id, parent_id, created_at, updated_at)
        VALUES (#{name}, #{projectId}, #{parentId}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE modules
        SET name = #{name}, project_id = #{projectId}, parent_id = #{parentId}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM modules WHERE id = #{id}
    </delete>

    <select id="findByProjectId" resultMap="BaseResultMap">
        SELECT * FROM modules WHERE project_id = #{projectId}
    </select>

    <select id="findByProjectIdAndParentId" resultMap="BaseResultMap">
        SELECT * FROM modules WHERE project_id = #{projectId} AND parent_id = #{parentId}
    </select>

    <select id="findByProjectIdAndParentIdIsNull" resultMap="BaseResultMap">
        SELECT * FROM modules WHERE project_id = #{projectId} AND parent_id IS NULL
    </select>

    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM modules WHERE parent_id = #{parentId}
    </select>
</mapper>
